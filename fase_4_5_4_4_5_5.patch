+async createWorldEntity(entityType, transform, initialData = undefined) {
+    const worldId = this.meta?.id;
+
+    if (
+        !worldId ||
+        this.meta.storage !== "shared" ||
+        this.multiplayerWorldId !== worldId
+    ) {
+        throw new Error("Entre em um mundo compartilhado antes de criar uma entidade.");
+    }
+
+    const payload = {
+        worldId,
+        entityType,
+        transform
+    };
+
+    if (initialData !== undefined) {
+        payload.initialData = initialData;
+    }
+
+    const response = await this.requestWorldEvent(
+        "world:entity:create",
+        payload
+    );
+
+    if (!this.worldEntities.upsert(response.entity, worldId)) {
+        throw new Error("O servidor retornou uma entidade inválida ou desatualizada.");
+    }
+
+    return this.worldEntities.get(response.entity.id);
+}

+async updateWorldEntity(entityId, changes = {}) {
+    const worldId = this.meta?.id;
+    const current = this.worldEntities.get(entityId);
+
+    if (
+        !worldId ||
+        this.meta.storage !== "shared" ||
+        this.multiplayerWorldId !== worldId
+    ) {
+        throw new Error("Entre em um mundo compartilhado antes de atualizar uma entidade.");
+    }
+
+    if (!current) {
+        throw new Error("A entidade não está carregada neste cliente.");
+    }
+
+    if (!changes || typeof changes !== "object" || Array.isArray(changes)) {
+        throw new Error("Dados de atualização inválidos.");
+    }
+
+    const expectedRevision = changes.expectedRevision ?? current.revision;
+    const payload = {
+        worldId,
+        entityId: current.id,
+        expectedRevision
+    };
+
+    if (Object.prototype.hasOwnProperty.call(changes, "operation")) {
+        payload.operation = changes.operation;
+    }
+
+    if (Object.prototype.hasOwnProperty.call(changes, "transform")) {
+        payload.transform = changes.transform;
+    }
+
+    const response = await this.requestWorldEvent(
+        "world:entity:update",
+        payload
+    );
+
+    if (!this.worldEntities.upsert(response.entity, worldId)) {
+        const latest = this.worldEntities.get(entityId);
+
+        if (!latest || latest.revision < Number(response.entity.revision)) {
+            throw new Error("A resposta de atualização da entidade é inválida.");
+        }
+
+        return latest;
+    }
+
+    return this.worldEntities.get(entityId);
+}

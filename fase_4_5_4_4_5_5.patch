+
+async removeWorldEntity(entityId, expectedRevision = undefined) {
+    const worldId = this.meta?.id;
+    const current = this.worldEntities.get(entityId);
+
+    if (
+        !worldId ||
+        this.meta.storage !== "shared" ||
+        this.multiplayerWorldId !== worldId
+    ) {
+        throw new Error("Entre em um mundo compartilhado antes de remover uma entidade.");
+    }
+
+    if (!current) {
+        throw new Error("A entidade não está carregada neste cliente.");
+    }
+
+    const response = await this.requestWorldEvent(
+        "world:entity:remove",
+        {
+            worldId,
+            entityId: current.id,
+            expectedRevision: expectedRevision ?? current.revision
+        }
+    );
+
+    this.worldEntities.remove(response, worldId);
+    return response;
+}

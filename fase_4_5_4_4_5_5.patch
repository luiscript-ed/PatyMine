+class WorldEntityManager {
+    constructor() {
+        this.worldId = null;
+        this.entities = new Map();
+        this.tombstones = new Map();
+    }
+
+    load(entities, worldId) {
+        if (!Array.isArray(entities)) {
+            throw new Error("A lista inicial de World Entities é inválida.");
+        }
+
+        const nextEntities = new Map();
+
+        for (const rawEntity of entities) {
+            const entity = normalizeWorldEntityRecord(rawEntity, worldId);
+
+            if (nextEntities.has(entity.id)) {
+                throw new Error("O servidor retornou uma World Entity duplicada.");
+            }
+
+            nextEntities.set(entity.id, entity);
+        }
+
+        this.worldId = String(worldId).toLowerCase();
+        this.entities = nextEntities;
+        this.tombstones.clear();
+    }
+
+    upsert(rawEntity, worldId) {
+        if (
+            !this.worldId ||
+            String(worldId).toLowerCase() !== this.worldId
+        ) {
+            return false;
+        }
+
+        const entity = normalizeWorldEntityRecord(rawEntity, this.worldId);
+        const removedRevision = this.tombstones.get(entity.id);
+        const current = this.entities.get(entity.id);
+
+        // UUID representa uma instância única: depois de removida,
+        // a mesma identidade nunca pode ser recriada por uma mensagem tardia.
+        if (removedRevision !== undefined) {
+            return false;
+        }
+
+        // Ignora duplicatas e revisões antigas.
+        if (current && entity.revision <= current.revision) {
+            return false;
+        }
+
+        this.entities.set(entity.id, entity);
+        return true;
+    }
+
+    remove(payload, expectedWorldId) {
+        if (
+            !payload ||
+            typeof payload !== "object" ||
+            Array.isArray(payload) ||
+            typeof payload.worldId !== "string" ||
+            payload.worldId.toLowerCase() !== String(expectedWorldId).toLowerCase() ||
+            typeof payload.entityId !== "string"
+        ) {
+            return false;
+        }
+
+        const entityId = payload.entityId.toLowerCase();
+        const revision = Number(payload.revision);
+
+        if (
+            !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(entityId) ||
+            !Number.isSafeInteger(revision) ||
+            revision < 1
+        ) {
+            return false;
+        }
+
+        const removedRevision = this.tombstones.get(entityId);
+        const current = this.entities.get(entityId);
+
+        if (removedRevision !== undefined && revision <= removedRevision) {
+            return false;
+        }
+
+        if (current && revision <= current.revision) {
+            return false;
+        }
+
+        this.entities.delete(entityId);
+        this.tombstones.set(entityId, revision);
+        return true;
+    }
+
+    get(entityId) {
+        return this.entities.get(String(entityId).toLowerCase()) ?? null;
+    }
+
+    values() {
+        return this.entities.values();
+    }
+
+    clear() {
+        this.worldId = null;
+        this.entities.clear();
+        this.tombstones.clear();
+    }
+}

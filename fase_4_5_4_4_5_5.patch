+async listWorldEntities(options = {}) {
+    const worldId = this.meta?.id;
+
+    if (
+        !worldId ||
+        this.meta.storage !== "shared" ||
+        this.multiplayerWorldId !== worldId
+    ) {
+        throw new Error("Entre em um mundo compartilhado antes de consultar entidades.");
+    }
+
+    const response = await this.requestWorldEvent(
+        "world:entities:list",
+        {
+            worldId,
+            ...(options.afterId ? { afterId: options.afterId } : {}),
+            ...(options.entityType ? { entityType: options.entityType } : {}),
+            ...(options.limit !== undefined ? { limit: options.limit } : {})
+        }
+    );
+
+    if (!Array.isArray(response.entities)) {
+        throw new Error("O servidor retornou uma lista de entidades inválida.");
+    }
+
+    for (const entity of response.entities) {
+        this.worldEntities.upsert(entity, worldId);
+    }
+
+    return {
+        entities: response.entities.map(entity =>
+            this.worldEntities.get(entity.id)
+        ).filter(Boolean),
+        hasMore: !!response.hasMore,
+        nextCursor: response.nextCursor ?? null
+    };
+}

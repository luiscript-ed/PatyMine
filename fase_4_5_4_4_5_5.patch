+function normalizeWorldEntityRecord(entity, expectedWorldId) {
+    if (
+        !entity ||
+        typeof entity !== "object" ||
+        Array.isArray(entity)
+    ) {
+        throw new Error("Registro de World Entity inválido.");
+    }
+
+    const id = typeof entity.id === "string"
+        ? entity.id.toLowerCase()
+        : "";
+
+    const worldId = typeof entity.world_id === "string"
+        ? entity.world_id.toLowerCase()
+        : "";
+
+    const dataVersion = Number(entity.data_version);
+    const revision = Number(entity.revision);
+
+    const position = {
+        x: Number(entity.position_x),
+        y: Number(entity.position_y),
+        z: Number(entity.position_z)
+    };
+
+    const yaw = Number(entity.yaw);
+
+    const velocity = {
+        x: Number(entity.velocity_x),
+        y: Number(entity.velocity_y),
+        z: Number(entity.velocity_z)
+    };
+
+    if (
+        !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id) ||
+        worldId !== String(expectedWorldId).toLowerCase() ||
+        typeof entity.entity_type !== "string" ||
+        !/^[a-z][a-z0-9:_-]{0,63}$/.test(entity.entity_type) ||
+        !Number.isSafeInteger(dataVersion) ||
+        dataVersion < 1 ||
+        !Number.isSafeInteger(revision) ||
+        revision < 1 ||
+        !Object.values(position).every(Number.isFinite) ||
+        Math.abs(position.x) > 100000 ||
+        position.y < 0 ||
+        position.y >= Wt ||
+        Math.abs(position.z) > 100000 ||
+        !Number.isFinite(yaw) ||
+        Math.abs(yaw) > 1000000 ||
+        !Object.values(velocity).every(Number.isFinite) ||
+        Object.values(velocity).some(value => Math.abs(value) > 1000) ||
+        !entity.data ||
+        typeof entity.data !== "object" ||
+        Array.isArray(entity.data)
+    ) {
+        throw new Error("A World Entity contém dados inválidos ou incompatíveis.");
+    }
+
+    return {
+        id,
+        world_id: worldId,
+        entity_type: entity.entity_type,
+        data_version: dataVersion,
+        position_x: position.x,
+        position_y: position.y,
+        position_z: position.z,
+        yaw,
+        velocity_x: velocity.x,
+        velocity_y: velocity.y,
+        velocity_z: velocity.z,
+        data: entity.data,
+        revision,
+        created_at: entity.created_at ?? null,
+        updated_at: entity.updated_at ?? null
+    };
+}
